FRONTEND_PORT=
MOBILE_GATEWAY_PORT=

# ==========================================
# COMUNES
LOG_LEVEL=
# Segundos.
HTTP_TIMEOUT=

# ==========================================
# SESIÓN Y SEGURIDAD
# Mínimo 32 bytes. Compartido por Auth y ambos gateways.
JWT_SECRET=
JWT_ALGORITHM=
# true solo con HTTPS.
COOKIE_SECURE=

# Orígenes exactos separados por comas, sin barra final ni comodines. Lo consume el gateway web.
WS_ALLOWED_ORIGINS

# ==========================================
# MYSQL (Auth)
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
OUTBOX_RELAY_INTERVAL_MS=

# ==========================================
# MONGODB DE PARTIDAS (Game Logic)
MONGO_DATABASE=
MONGO_USER=
MONGO_PASSWORD=
WAITING_TIMEOUT_MINUTES=

# Administrador de ambas instancias de MongoDB.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# ==========================================
# POSTGRESQL (Profile/Stats)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ==========================================
# MONGODB DE ANÁLISIS (Tutor y Analysis Worker)
MONGO_ANALYSIS_DATABASE=
MONGO_ANALYSIS_USER=
MONGO_ANALYSIS_PASSWORD=

# ==========================================
# RABBITMQ
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# ==========================================
# TUTOR
# Debe coincidir con la versión real de Stockfish de la imagen.
ENGINE_VERSION=
ANALYSIS_DEPTH_DEFAULT=
ANALYSIS_DEPTH_MAX=
ANALYSIS_MAX_REACTIVATIONS=
LLM_PROVIDER=

# ==========================================
# MULTIPLAYER (perfil pendiente)
RECONNECT_WINDOW_SECONDS=

# ==========================================
# ANALYSIS WORKER (perfil pendiente)
ANALYSIS_MAX_RETRIES=
ANALYSIS_INACCURACY_CP=
ANALYSIS_MISTAKE_CP=
ANALYSIS_BLUNDER_CP=
POLL_INTERVAL_SECONDS=
ANALYSIS_STALE_MINUTES=

# ==========================================
# TIMEOUT WORKER (perfil pendiente)
TIMEOUT_POLL_INTERVAL_SECONDS=
TIMEOUT_BATCH_LIMIT=

# ==========================================
# ENTRADAS PÚBLICAS Y CANAL SEGURO (TLS) - docs/secure-channel-tls.md
# docker compose up --build -d: compose.yaml pone los WAF (waf-web, waf-mobile) delante de los reverse proxies.
# Solo los WAF publican puertos; los proxies y el resto de servicios no.
# HTTP de la web: solo redirección a HTTPS (p. ej. 80 u 8080).
FRONTEND_PORT=
# HTTPS/WSS de la web (p. ej. 443 u 8443).
FRONTEND_HTTPS_PORT=
# HTTPS de la app Android (p. ej. 8444). El HTTP móvil no se publica.
MOBILE_HTTPS_PORT=
# Strict-Transport-Security en segundos: 0 en desarrollo (localhost), 31536000 con un dominio real.
HSTS_MAX_AGE=

# Certificados (fuera de Git, montados en solo lectura). Ver docs/secure-channel-tls.md, sección 8.1.
# Público de desarrollo de los WAF (mkcert; SAN localhost, 127.0.0.1, ::1, 10.0.2.2), p. ej. ./certs/edge
EDGE_TLS_DIR=
# CA INTERNA (distinta de mkcert) que valida el WAF en el tramo WAF -> proxy: solo el .crt, p. ej.
# ./certs/internal/ca/ca.crt. La generan secure-channel/generar_certs_internos.py; la clave nunca se monta.
INTERNAL_CA_CERT=
# Certificados internos de los proxies (SAN = nombre del servicio),
# p. ej. ./certs/internal/reverse-proxy-web y ./certs/internal/reverse-proxy-mobile
INTERNAL_WEB_TLS_DIR=
INTERNAL_MOBILE_TLS_DIR=

# ==========================================
# COMUNES
LOG_LEVEL=
# Segundos.
HTTP_TIMEOUT=

# ==========================================
# SESIÓN Y SEGURIDAD
# Mínimo 32 bytes. Compartido por Auth y ambos gateways.
JWT_SECRET=
JWT_ALGORITHM=
# true con HTTPS (configuración normal): la cookie session solo viaja cifrada.
COOKIE_SECURE=

# Orígenes exactos separados por comas, sin barra final ni comodines. Lo consume el gateway web.
# Debe coincidir con la URL HTTPS del navegador: https://localhost si FRONTEND_HTTPS_PORT=443, si no
# https://localhost:<FRONTEND_HTTPS_PORT>. Si no coincide, el WebSocket del ajedrez se cierra con 4403.
WS_ALLOWED_ORIGINS=

# ==========================================
# MYSQL (Auth)
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
OUTBOX_RELAY_INTERVAL_MS=

# ==========================================
# MONGODB DE PARTIDAS (Game Logic)
MONGO_DATABASE=
MONGO_USER=
MONGO_PASSWORD=
WAITING_TIMEOUT_MINUTES=

# Administrador de ambas instancias de MongoDB.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# ==========================================
# POSTGRESQL (Profile/Stats)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ==========================================
# MONGODB DE ANÁLISIS (Tutor y Analysis Worker)
MONGO_ANALYSIS_DATABASE=
MONGO_ANALYSIS_USER=
MONGO_ANALYSIS_PASSWORD=

# ==========================================
# RABBITMQ
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# ==========================================
# TUTOR
# Debe coincidir con la versión real de Stockfish de la imagen.
ENGINE_VERSION=
ANALYSIS_DEPTH_DEFAULT=
ANALYSIS_DEPTH_MAX=
ANALYSIS_MAX_REACTIVATIONS=
LLM_PROVIDER=

# ==========================================
# MULTIPLAYER (perfil pendiente)
RECONNECT_WINDOW_SECONDS=

# ==========================================
# ANALYSIS WORKER (perfil pendiente)
ANALYSIS_MAX_RETRIES=
ANALYSIS_INACCURACY_CP=
ANALYSIS_MISTAKE_CP=
ANALYSIS_BLUNDER_CP=
POLL_INTERVAL_SECONDS=
ANALYSIS_STALE_MINUTES=

# ==========================================
# TIMEOUT WORKER (perfil pendiente)
TIMEOUT_POLL_INTERVAL_SECONDS=
TIMEOUT_BATCH_LIMIT=

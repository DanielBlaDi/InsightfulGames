# Entrada MÓVIL (contenedor reverse-proxy-mobile). Se carga después de common.conf.
# Plantilla: al arrancar, la imagen de Nginx sustituye ${HSTS_MAX_AGE} (envsubst).
#
#   :8443 HTTPS (MOBILE_HTTPS_PORT)  /*  -> api-gateway-mobile:8090   (la app usa BASE_URL = raíz, sin prefijo)
#   :8090 HTTP                       solo /health para el healthcheck interno; NO se publica en el host.
#
# /internal/* responde 404 aquí, sin llegar al gateway móvil.

# HTTP en claro: solo salud. La app nunca habla por aquí (su release bloquea HTTP).
server {
    listen 8090;
    server_name _;

    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location / {
        default_type application/json;
        return 403 '{"error":{"code":"HTTPS_REQUIRED","message":"Usa https://"}}';
    }
}

# HTTPS: único canal con datos de la app Android.
server {
    listen 8443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;

    add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}" always;

    client_max_body_size 1m;

    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # El gateway móvil solo habla con /internal/* hacia dentro; desde fuera no existe.
    location ~* ^/internal(/|$) {
        default_type application/json;
        return 404 '{"error":{"code":"NOT_FOUND","message":"Ruta inexistente"}}';
    }

    location ~ ^/auth/(login|register)/?$ {
        limit_req zone=auth_zone burst=20 nodelay;

        set $mobile_gateway http://api-gateway-mobile:8090;
        proxy_pass $mobile_gateway;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-User-Id "";
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        set $mobile_gateway http://api-gateway-mobile:8090;
        proxy_pass $mobile_gateway;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-User-Id "";
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 65 s, como la entrada web: DELETE /auth/account (saga) puede tardar hasta 4 x HTTP_TIMEOUT.
        proxy_read_timeout 65s;
    }
}

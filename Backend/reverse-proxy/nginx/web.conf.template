# Entrada WEB (contenedor reverse-proxy-web). Se carga después de common.conf.
# Plantilla: al arrancar, la imagen de Nginx sustituye ${PUBLIC_HTTPS_PORT} y ${HSTS_MAX_AGE} (envsubst).
#
#   :8443 HTTPS (FRONTEND_HTTPS_PORT)  /           -> frontend-component:80           (Express + Vike)
#                                      /api/*      -> api-gateway-component:8080      (sin /api)
#                                      /api/ws/*   -> api-gateway-component:8080      (WebSocket: WSS)
#   :8000 HTTP  (FRONTEND_PORT)        solo /health; las páginas redirigen (308) a HTTPS y /api/* responde
#                                      403 HTTPS_REQUIRED (no se reenvía nada en claro al gateway).
#
# /api/internal/* responde 404 aquí, sin llegar al gateway. El gateway no expone ninguna ruta /internal
# (ningún servicio lo llama); el bloqueo se mantiene como defensa en profundidad.

# HTTP en claro: no transporta datos de la aplicación (Secure Channel Pattern).
server {
    listen 8000;
    server_name _;

    # Salud del propio proxy: la usa el healthcheck del contenedor (127.0.0.1) y no contiene datos.
    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # La API (REST y WebSocket) nunca se sirve por HTTP: ni se redirige (un POST con credenciales ya habría
    # viajado en claro y el cliente debe fallar de forma visible) ni se reenvía al gateway.
    location /api/ {
        default_type application/json;
        return 403 '{"error":{"code":"HTTPS_REQUIRED","message":"Usa https://"}}';
    }

    # Páginas: redirección permanente a HTTPS conservando ruta y consulta (308 mantiene el método).
    location / {
        return 308 https://$host:${PUBLIC_HTTPS_PORT}$request_uri;
    }
}

# HTTPS: único canal con datos. Certificado y clave montados en solo lectura desde el host (compose.yaml).
server {
    listen 8443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;

    # HSTS: el navegador recordará usar solo HTTPS. 0 en desarrollo (localhost); 31536000 en producción.
    add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}" always;

    # Los cuerpos reales son JSON pequeños.
    client_max_body_size 1m;

    # Cada location que reenvía repite sus proxy_set_header: en Nginx, definir uno solo en un
    # location anula los heredados del server. X-User-Id "" corta en el borde la cabecera que
    # el gateway pone tras validar el JWT (el gateway también la descarta).

    # Salud del propio proxy (no depende de los destinos).
    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # /api/internal/* nunca llega al gateway. Nginx compara la ruta ya normalizada (decodificada,
    # sin barras repetidas ni "..") y sin distinguir mayúsculas, así que /API/Internal,
    # /api//internal o /api/%69nternal también caen aquí. Una expresión regular gana a los
    # prefijos /api/ y /api/ws/ de abajo.
    location ~* ^/api/internal(/|$) {
        default_type application/json;
        return 404 '{"error":{"code":"NOT_FOUND","message":"Ruta inexistente"}}';
    }

    # WebSocket del ajedrez: /api/ws/* -> gateway /ws/* . Origin y Cookie pasan tal cual;
    # el gateway valida Origin contra WS_ALLOWED_ORIGINS y la sesión.
    location /api/ws/ {
        set $web_gateway http://api-gateway-component:8080;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $web_gateway;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-User-Id  "";
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Registro y login: mismo destino que /api/, con límite de frecuencia.
    location ~ ^/api/auth/(login|register)/?$ {
        limit_req zone=auth_zone burst=20 nodelay;

        set $web_gateway http://api-gateway-component:8080;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $web_gateway;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-User-Id "";
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 65s;
    }

    # REST: /api/* -> gateway /* . Set-Cookie, Cookie e Idempotency-Key pasan sin tocar.
    # 65 s cubre DELETE /auth/account (4 x HTTP_TIMEOUT), igual que el proxy anterior del frontend.
    location /api/ {
        set $web_gateway http://api-gateway-component:8080;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $web_gateway;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-User-Id "";
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 65s;
    }

    # Todo lo demás: páginas y estáticos del frontend.
    location / {
        set $web_frontend http://frontend-component:80;
        proxy_pass $web_frontend;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-User-Id "";
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
